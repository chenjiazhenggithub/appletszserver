.card-top-img {
  width: 52rpx;
  height: 42rpx;
  float: right;
  margin: 20rpx 40rpx 20rpx 0;
}
.card-top-img::before, .card-top-img::after {
  content: '';
  display: table;
}
.card-top-img::after{
  clear: both;
}
.cardbox {
  width: 96%;
  background-color: #ffffff;
  margin: 0 auto 15rpx auto;
  border-radius: 10px;
  padding-top: 25rpx;
}
.content_vouchers {
  font-size: 11px;
  color: #ffffff;
  background-color: #F5001C;
  width: auto;
  padding: 5rpx;
  border-radius: 6rpx;
}
.code {
  width: 36rpx;
  height: 36rpx;
}
.content_leftbox {
  padding-left: 30rpx;
}
.content_contbox {
  width: 425rpx;
  padding-left: 60rpx;
  overflow: hidden;
  line-height: 30rpx;
}
.content_rightbox {
  padding-left: 60rpx;
}
.number {
  font-size: 35px;
}
.unti {
  font-weight: bold;
  padding-left: 10rpx;
  line-height: 58px;
}
.content_leftbottombox {
  padding-left: 30rpx;
  display: inline-flex;
  width: 124rpx;
}
.content_contentbottonmbox {
  color: #CACACA;
  width: 425rpx;
  overflow: hidden;
  font-size: 11px;
  padding-top: 25rpx;
}
.content_button {
  width: 120rpx;
  height: 45rpx;
  line-height: 45rpx;
  background-color: #F5001C;
  border-radius: 20px;
  color: #ffffff;
  font-size: 12px;
  text-align: center;
}
.buttonbox {
  padding-right: 25rpx;
  padding-top: 40rpx;
}
.remarkbox {
  color: #626A6F;
  padding: 10rpx 20rpx 10rpx 33rpx;
  font-size: 12px;
  overflow: hidden;
  transition: height 10s;
}
.border {
  height: 1rpx;
  background-color: #CACACA;
  width: 91%;
  margin: auto;
}