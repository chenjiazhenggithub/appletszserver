/**scan.wxss**/
page {
  background-color: #f1f1f1;
}
.title {
  font-weight: bold;
  color: #1a1a1a;
  font-family: fantasy;
  padding-top: 60rpx;
}

.title-bottom {
padding-top: 58rpx;
color: #c1c1c1;
font-size: 13px;
}

.logo {
  width: 138rpx;
  height: 68rpx;
}

.logo-box {
  margin-top: 62rpx;
}

.box {
  height: 1400rpx;
}

.scan-view {
  width: 100%;
  padding-bottom: 520rpx;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  /* position: fixed; */
  align-items: center;
  justify-content: space-around;
}

.scan-border {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 105rpx;
  position: relative;
}

.scan-camera {
  width: 450rpx;
  height: 450rpx;
  /* border-radius: 5%; */
  border-radius: 6rpx;
  /* padding: 30rpx; */
}

.cover-corner {
  width: 474rpx;
  height: 474rpx;
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  /* background-color: red; */
  border-radius: 40rpx;
}

.scan-animation {
  position: absolute;
  top: -10rpx;
  left: 0rpx;
  width: 447rpx;
  height: 8rpx;
  background-color: #fff;
  border-radius: 50%;
}