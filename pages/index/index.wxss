/**index.wxss**/
.top-imgae {
  width: 750rpx;
  height: 250rpx;
  position: relative;
}
.top-text {
  position: absolute;
  top: 44rpx;
  left: 15rpx;
  font-size: 26.82rpx;
}

.top-box {
  display: flex;
  flex-direction: unset;
  width: 722rpx;
  height: 146rpx;
  background-color: #e6e6e6;
  position: absolute;
  top: 141rpx;
  left: 15rpx;
  border-radius: 30rpx;
  align-items: center;
}

.userinfo {
  display: flex;
  flex-direction: unset;
  align-items: center;
}

.userinfo-avatar {
  width: 75rpx;
  height: 75rpx;
  margin: 20rpx;
  border-radius: 50%;
  overflow: hidden;
}

.userinfo-nickname {
  color: #aaa;
  /* padding-top: 38rpx; */
  font-size: 27.5rpx;
}

.usermotto {
  padding-bottom: 24rpx;
