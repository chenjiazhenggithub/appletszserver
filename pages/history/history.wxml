
<view class="box" style="margin-top: 20px;">
  <view class="top-box">
    <van-dropdown-menu class="head-dropdown text" active-color="#dfd1ba">
      <van-dropdown-item value="{{ SfCardId1 }}" options="{{ option2 }}" />
    </van-dropdown-menu>
    <van-cell-group class="head-input">
      <van-cell bind:click="onChangefield"  value="{{ timevalue }}">
        <van-icon slot="right-icon" name="calendar-o" class="custom-icon" />
      </van-cell>
    </van-cell-group>
  </view>
  <view class="top-box" style="margin-top: 20px;">
    <van-dropdown-menu class="head-dropdown" active-color="#dfd1ba">
      <van-dropdown-item value="{{ SfCardId }}" bind:change="onChangedropdown" options="{{ option1 }}" />
    </van-dropdown-menu>
    <van-cell-group class="head-input">
      <van-field
      value="{{ carNo }}"
      placeholder=""
      border="{{ false }}"
      bind:change="onChangefield1"
      />
    </van-cell-group>
  </view>
  <view class="button-box">
    <van-button type="default" bind:click="getList">查询</van-button>
  </view>
  <view wx:if="{{historydata.length > 0}}" style="padding: 0 0 15px 3%;">记录数：{{historydata.length}}</view>
  <view style="padding-bottom: 50px;">
    <view class="bottombox"  wx:for="{{historydata}}" wx:key="index">
    <view class="iconbox">{{index + 1}}</view>
    <view style="margin-left: 50px;">
      <view class="textbox" style="justify-content: space-between;align-items: center;">
        <view style="font-size: 13px;">{{item.scanstr}}</view>
        <view>{{item.cname}}</view>
      </view>
      <view class="textbox" style="margin-top: 30px;justify-content: space-between;">
        <view style="display: flex;">{{item.CarNo}}<view style="font-size: 10px;line-height: 25px;" wx:if="{{item.UseBrand}}">（{{item.UseBrand}}）</view></view>
        <!-- <view style="font-size: 12px;margin-right: 32%;margin-top: 3px;"></view> -->
        <view style="font-size: 12px;color: #8f8f8f;margin-top: 3px;">{{item.bICouponTypeName}}</view>
      </view>
    </view>
    </view>
  </view>
  <van-calendar
    show="{{ timeshow }}"
    type="range"
    bind:close="onClose"
    bind:confirm="onConfirm"
    color="#c0a474"
    min-date="{{ minDate }}"
    max-date="{{ maxDate }}"
  />
</view>