.alliancebox {
  width: 100%;
  height: 100vh;
  background-image: url('data:image/png;base64,');
  background-size: 100% 100%;
}

p {
  display: block;
}

.modalbox {
  width: 83%;
  margin: 0 auto;
  /* height: 1100rpx; */
  border-radius: 20px;
  position: relative;
  top: 6.034rem;
  background-image: radial-gradient(circle at 15px 160px, transparent 15px, white 15px);
  background-position: -15px -1.5rem;
}

.box_top {
  height: 236.19rpx;
}

.all-card {
  width: 100%;
  padding-top: 36rpx;
  font-size: 20px;
  text-align: center;
  color: #000000;
}

#imgPast {
  position: absolute;
  width: 227rpx;
  height: 225rpx;
  /* 0: %; */
  z-index: 9999;
  right: 0;
  top: 100rpx;
  background: url('data:image/png;base64,');
  background-size: 100% 100%;
}

.timetext {
  width: 78%;
  text-align: center;
  margin: auto;
  color: #f5001c;
  font-weight: bold;
  font-size: 18.5px;
  margin-top: 0.5rem;
  line-height: 35px;
}

.box_bottom {
  /* height: 30.98rem; */
}

.border {
  width: 85%;
  height: 0.5px;
  background-color: #ebebeb;
  border: 0;
  margin: 0 auto;
  position: relative;
}

.card-num {
  font-size: 18.5px;
  color: #535353;
  text-align: center
}

.codebox {
  width: 13.8rem;
  height: 13.8rem;
  border: 1px solid #ebebeb;
  margin: 0.8rem auto 0.8rem auto;
  border-radius: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.codeborder-wrap {
  position: relative;
  width: 345rpx;
  height: 345rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.codeborder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.card-code {
  display: block;
}

.tips {
  color: #161616;
}

.time {
  color: #b7b7b7;
  font-size: 90%;
  margin-top: 0.4rem;
  margin-bottom: 0.8rem;
}

.footer {
  height: auto;
  padding: 5% 0;
  font-size: 120%;
  padding-left: 1rem;
}

#allianceCode .footer p.card-desc {
  margin-bottom: 5px;
}
.active {
  height: 35rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 91%;
}
.desctext {
    font-size: 74%;
    text-align: left;
    overflow: hidden;
    color: #8d8d8d;
    padding-right: 2rem;
    display: inline-block;
    line-height: 1.3rem;
}

#allianceCode {
  min-height: 100vh;
}