
<view class="box" style="margin-top: 20px;">
  <view class="top-box">
    <van-dropdown-menu class="head-dropdown" active-color="#dfd1ba">
      <van-dropdown-item value="{{ SfCardId }}" bind:change="onChangedropdown" options="{{ option1 }}" />
    </van-dropdown-menu>
    <van-cell-group class="head-input">
      <van-field
      value="{{ RegisterNo }}"
      placeholder=""
      border="{{ false }}"
      bind:change="onChangefield"
      />
    </van-cell-group>
  </view>
  <view class="button-box">
    <van-button type="default" bind:click="getList">查询信息</van-button>
  </view>
  <view style="padding-bottom: 50px;">
    <van-tabs active="{{ active }}" swipe-threshold="4">
      <van-tab title="会员信息">
        <view wx:if="{{custormshow}}" ></view>
        <view style="height: 540px;overflow-y: scroll;" wx:else="!{{custormshow}}">
          <view class="text-box">
            <text class="left-text">车牌号</text>
            <text class="right-text" user-select="true">{{BaseData.RegisterNo}}</text>
          </view>
          <view class="text-box">
            <text class="left-text">车架号</text>
            <text class="right-text" user-select="true">{{BaseData.vin}}</text>
          </view>
          <view class="text-box">
            <text class="left-text">会员级别</text>
            <text class="right-text" user-select="true">{{BaseData.CardlevelName}}</text>
          </view>
          <view class="text-box">
            <text class="left-text">客户姓名</text>
            <text class="right-text" user-select="true">{{BaseData.GuestName}}</text>
          </view>
          <view class="text-box">
            <text class="left-text">手机号</text>
            <text class="right-text" user-select="true" style="width:48%;">{{BaseData.Mobile}}</text>
            <image wx:if="{{BaseData.Mobile}}" bindtap='clickPhone' src="/pages/index/images/customr-phone.png"  style="width: 25px;height: 25px;"/>
          </view>
          <view class="text-box">
            <text class="left-text">购车日期</text>
            <text class="right-text" user-select="true">{{BaseData.SellCardDate}}</text>
          </view>
          <view class="text-box">
            <text class="left-text">商业险到期日期</text>
            <text class="right-text" user-select="true">{{BaseData.a_enddate_1}}</text>
          </view>
          <van-divider contentPosition="center">附加信息</van-divider>
          <view class="text-box" wx:for="{{FujiaxinxiData}}" wx:key="index" wx:if="{{item.TblName !== '' && item.TblName !== null && item.TblName !== '否'}}">
            <text class="left-text">{{item.DispName}}</text>
            <text style="margin-left:10px;" user-select="true">{{item.TblName}}</text>
          </view>
        </view>
      </van-tab>
      <van-tab title="优惠项目">
        <view wx:if="{{chuzhishow}}" ></view>
        <view style="height: 540px;overflow-y: scroll;" wx:else="!{{chuzhishow}}">
          <!-- <view style="color: #c0a474;margin: 20px 0 0 24px;">储值金额: {{chuzhitotal}}<span style="font-size: 10px;margin-left: 2px;">元</span></view> -->
          <view class="imgbox" wx:for="{{diyongquanData}}" wx:key="index">
            <image src="/pages/index/images/diyongjuan.png" wx:if="{{item.CanUseFlag === '有效'}}" class="diyongimg"  style="width: 100%;height: 96px;"/>
            <image src="/pages/index/images/outtime.png" wx:if="{{item.CanUseFlag === '失效'}}" class="diyongimg"  style="width: 100%;height: 96px;"/>
            <image src="/pages/index/images/weishengxiao.png" wx:if="{{item.CanUseFlag === '未生效'}}" class="diyongimg"  style="width: 100%;height: 96px;"/>
            <view class="imgbox-left">
              <view class="newclass3 {{item.CanUseFlag === '有效' ? 'text-valid' : 'text-invalid'}}">{{item.balance}}张</view>
              <view class="newclass1 {{item.CanUseFlag === '有效' ? 'text-valid' : 'text-invalid'}}">{{item.type}}</view>
            </view>
            <view class="imgbox-right">
              <view class="newclass item-title-width {{item.CanUseFlag === '有效' ? 'text-valid' : 'text-invalid'}}">{{item.favorableName}}</view>
              <view style="width: 86%;height: 1px;border-bottom: 1px dashed #ebebeb;margin: 0px auto 0 auto;"></view>
              <view style="color: #cccccc;font-size: 12px;float: right;margin: 8px 15px 0 0;">{{item.Startdate || '无期限'}} - {{item.enddate || '无期限'}}</view>
            </view>
          </view>
          <view class="imgbox" wx:for="{{chuzhiData}}" wx:key="index">
            <image src="/pages/index/images/diyongjuan.png" wx:if="{{item.CanUseFlag === '有效'}}" style="width: 100%;height: 96px;"/>
            <image src="/pages/index/images/outtime.png" wx:if="{{item.CanUseFlag === '失效'}}" style="width: 100%;height: 96px;"/>
            <image src="/pages/index/images/weishengxiao.png" wx:if="{{item.CanUseFlag === '未生效'}}" style="width: 100%;height: 96px;"/>
            <view class="imgbox-left" style="word-wrap:break-word;word-break:normal;">
              <view class="newclass2 {{item.CanUseFlag === '有效' ? 'text-valid' : 'text-invalid'}}"><text>￥</text><text style="font-size: 19px;">{{item.balance}}</text></view>
              <view class="newclass1 {{item.CanUseFlag === '有效' ? 'text-valid' : 'text-invalid'}}">储值卡</view>
            </view>
            <view class="imgbox-right">
              <view class="newclass item-title-width {{item.CanUseFlag === '有效' ? 'text-valid' : 'text-invalid'}}">{{item.favorableName}}</view>
              <view style="width: 86%;height: 1px;border-bottom: 1px dashed #ebebeb;margin: 0px auto 0 auto;"></view>
              <view style="color: #cccccc;font-size: 12px;float: right;margin: 8px 15px 0 0;">{{item.Startdate || '无期限'}} - {{item.enddate || '无期限'}}</view>
            </view>
          </view>
        </view>
      </van-tab>
    </van-tabs>
  </view>
</view>
<van-popup show="{{ show }}" bind:close="onClose" round="true" custom-style="width:93%;">
  <view>
      <view style="text-align: center;margin:20px auto;color:#000000;">
        <text>会员列表</text>
      </view>
      <view style="margin-bottom: 30px;" class="{{list.length > 4 ? 'autobox' : ''}}">
        <view class="listbox {{item.class}}" wx:for="{{list}}" wx:key="index" data-item="{{item}}" data-index="{{index}}" bindtap="changelist">
          <view style="line-height: 20px;margin-left: 15px;">
            <view style="margin-bottom: 10px;font-size:15px;">{{item.CarNo}}</view>
            <view style="color: #b7b7b5;font-size:14px;">{{item.GuestName}}</view>
          </view>
          <view style="margin-right: 5px;">
            <van-checkbox checked-color="{{item.color}}" value="true"></van-checkbox>
          </view>
        </view>
      </view>
      <view class="button-box" style="height: 50px;width: 314.5px;">
        <van-button type="default" bind:click="getModalList">查询信息</van-button>
      </view>
  </view>
</van-popup>